OMNIDIM_API_KEY=your_api_key_here
OMNIDIM_API_BASE=https://backend.omnidim.io/api/v1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
PORT=3000
BRAND_NAME=MNB Omni Caller
# DATA_DIR=/var/lib/mnb-omni-caller
# REDIS_URL=redis://...          # Upstash Redis for persistent storage
# NTFY_TOPIC=your-private-topic  # push alert on each new lead (install the ntfy app)
# CALLMEBOT_APIKEY=...           # optional: WhatsApp alert via CallMeBot
# CALLMEBOT_PHONE=91XXXXXXXXXX

# ---- Public API (/api/v1) ----
# Per-key rate limit for customer API keys.
API_RATE_MAX=120
API_RATE_WINDOW=60

# ---- Bulk campaign cost guard ----
# Minutes budgeted per campaign contact when checking the balance.
CAMPAIGN_MIN_PER_CALL=1

# ---- Security ----
# Set to 1 only to temporarily disable the Content-Security-Policy header.
# CSP_DISABLED=
